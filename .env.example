# ══════════════════════════════════════════════════════════════════════════════
# GAMAD Deploy — Variables d'environnement de production
# Copiez ce fichier en .env et renseignez toutes les valeurs avant de lancer
# le stack Docker.
#
# ⚠  Ne commitez jamais le fichier .env — il est dans .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Utilisateur de la base de données (défaut : gamad)
POSTGRES_USER=gamad

# ⬇ OBLIGATOIRE — mot de passe fort pour PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Nom de la base de données (défaut : gamad)
POSTGRES_DB=gamad

# URL de connexion complète (construite automatiquement par docker-compose.prod.yml
# à partir des variables ci-dessus ; vous pouvez la surcharger ici si besoin)
# DATABASE_URL=postgresql://gamad:CHANGE_ME@postgres:5432/gamad

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Secrets de signature / chiffrement (générés automatiquement par install.sh)
# Ne modifiez ces valeurs QUE si vous savez ce que vous faites.
# Changer JWT_SECRET invalide toutes les sessions actives.

# Signature des tokens JWT (32 octets hex)
JWT_SECRET=GENERATED_BY_INSTALL_SCRIPT

# Clé de chiffrement symétrique (32 octets hex)
ENCRYPTION_KEY=GENERATED_BY_INSTALL_SCRIPT

# Secret de session Express (32 octets hex)
SESSION_SECRET=GENERATED_BY_INSTALL_SCRIPT

# Sel pour le hachage des agent tokens
# ⬇ OBLIGATOIRE — chaîne aléatoire longue (≥ 32 caractères)
AGENT_TOKEN_SALT=CHANGE_ME_random_salt_here

# ── Control plane ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Token d'authentification de l'agent GAMAD installé sur chaque VPS
# (optionnel ici si géré par table en base de données)
AGENT_TOKEN=
AGENT_BASE_URL=

# URL publique du control plane — utilisée par les agents VPS distants pour envoyer
# leurs callbacks (POST /agent/callback).
# Exemples :
#   - avec domaine  : CONTROL_PLANE_URL=https://gamad.example.com/api
#   - HTTP local    : CONTROL_PLANE_URL=http://control-plane:3000
# Si absent, le control plane déduit l'URL depuis DOMAIN (https) ou utilise
# http://control-plane:3000 (réseau Docker interne).
CONTROL_PLANE_URL=

# ── GitHub OAuth (C-14 / ADR-0013) ───────────────────────────────────────────
# Créez une OAuth App sur https://github.com/settings/developers
#   Authorization callback URL : https://VOTRE_DOMAINE/api/auth/github/callback
#
# ⬇ OBLIGATOIRE pour le repo picker, la normalisation et le fork auto
GITHUB_OAUTH_CLIENT_ID=CHANGE_ME_github_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME_github_oauth_app_client_secret
GITHUB_OAUTH_CALLBACK_URL=https://VOTRE_DOMAINE/api/auth/github/callback

# URL du frontend — utilisée pour la redirection après le callback OAuth GitHub.
# Si absent, dérivée automatiquement depuis CONTROL_PLANE_URL ou DOMAIN.
# Définir explicitement si votre frontend est sur un domaine différent du control plane.
FRONTEND_URL=https://VOTRE_DOMAINE

# Clé AES-256-GCM pour chiffrer les tokens GitHub au repos (32 octets base64)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_OAUTH_TOKEN_KEY=CHANGE_ME_run_command_above_to_generate

# ── GeniusPay (paiement) ──────────────────────────────────────────────────────
# ⬇ OBLIGATOIRE pour le module billing
GENIUSPAY_API_KEY=CHANGE_ME_your_geniuspay_api_key
GENIUSPAY_API_SECRET=CHANGE_ME_your_geniuspay_api_secret
GENIUSPAY_WEBHOOK_SECRET=CHANGE_ME_your_geniuspay_webhook_secret

# ── Domaine et SSL (optionnel) ────────────────────────────────────────────────
# Si renseigné, install.sh configure certbot et le HTTPS automatiquement.
# Laissez vide pour une installation HTTP uniquement.
DOMAIN=

# E-mail pour les notifications certbot (Let's Encrypt)
# Obligatoire si DOMAIN est renseigné.
CERTBOT_EMAIL=admin@yourdomain.com
